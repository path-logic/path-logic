{
    "hosting": [
        {
            "target": "web",
            "public": "dist/app/browser",
            "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ]
        },
        {
            "target": "storybook",
            "public": "dist/app/storybook",
            "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
        }
    ]
}
