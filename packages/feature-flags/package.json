{
    "name": "@path-logic/feature-flags",
    "version": "0.1.0",
    "description": "Lightweight feature flags for Angular with route-based toggling",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "angular",
        "feature-flags",
        "feature-toggles",
        "typescript"
    ],
    "author": "Path Logic Team",
    "license": "MIT",
    "peerDependencies": {
        "@angular/core": ">=19.0.0"
    },
    "devDependencies": {
        "typescript": "^5.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/path-logic/feature-flags.git"
    },
    "bugs": {
        "url": "https://github.com/path-logic/feature-flags/issues"
    },
    "homepage": "https://github.com/path-logic/feature-flags#readme"
}
