{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "baseUrl": "..",
        "paths": {
            "@/*": ["./src/*"],
            "@path-logic/core": ["../../packages/core/src/index.ts"],
            "@path-logic/feature-flags": ["../../packages/feature-flags/src/index.ts"],
            "@path-logic/feature-flags/client": ["../../packages/feature-flags/src/client.ts"],
            "@path-logic/feature-flags/components": [
                "../../packages/feature-flags/src/components/index.ts"
            ]
        }
    },
    "include": [
        "../src/**/*.stories.tsx",
        "../src/**/__stories__/*.tsx",
        "../src/**/*.ts",
        "../src/**/*.tsx",
        "**/*.ts",
        "**/*.tsx"
    ],
    "exclude": ["../node_modules"]
}
