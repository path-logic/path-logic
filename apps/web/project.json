{
    "name": "web",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "app",
    "sourceRoot": "apps/web/src",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/web",
                "browser": "apps/web/src/main.ts",
                "tsConfig": "apps/web/tsconfig.app.json",
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "apps/web/public"
                    }
                ],
                "styles": ["apps/web/src/styles.css"]
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "500kb",
                            "maximumError": "1mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "4kb",
                            "maximumError": "8kb"
                        }
                    ],
                    "outputHashing": "all",
                    "fileReplacements": [
                        {
                            "replace": "apps/web/src/environments/environment.ts",
                            "with": "apps/web/src/environments/environment.prod.ts"
                        }
                    ]
                },
                "staging": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "500kb",
                            "maximumError": "1mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "4kb",
                            "maximumError": "8kb"
                        }
                    ],
                    "outputHashing": "all",
                    "fileReplacements": [
                        {
                            "replace": "apps/web/src/environments/environment.ts",
                            "with": "apps/web/src/environments/environment.staging.ts"
                        }
                    ]
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                },
                "e2e": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true,
                    "fileReplacements": [
                        {
                            "replace": "apps/web/src/environments/environment.ts",
                            "with": "apps/web/src/environments/environment.e2e.ts"
                        }
                    ]
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "continuous": true,
            "executor": "@angular/build:dev-server",
            "configurations": {
                "production": {
                    "buildTarget": "web:build:production"
                },
                "development": {
                    "buildTarget": "web:build:development"
                },
                "e2e": {
                    "buildTarget": "web:build:e2e"
                }
            },
            "defaultConfiguration": "development"
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "test": {
            "executor": "@angular/build:unit-test",
            "options": {}
        },
        "serve-static": {
            "continuous": true,
            "executor": "@nx/web:file-server",
            "options": {
                "buildTarget": "web:build",
                "port": 4200,
                "staticFilePath": "dist/apps/web/browser",
                "spa": true
            }
        },
        "build-storybook": {
            "executor": "@storybook/angular:build-storybook",
            "outputs": ["{projectRoot}/storybook-static"],
            "options": {
                "configDir": "apps/web/.storybook",
                "browserTarget": "web:build:development",
                "compodoc": true,
                "compodocArgs": ["-e", "json", "-d", "apps/web"],
                "outputDir": "apps/web/storybook-static"
            },
            "cache": true
        },
        "storybook": {
            "executor": "@storybook/angular:start-storybook",
            "options": {
                "port": 6006,
                "configDir": "apps/web/.storybook",
                "browserTarget": "web:build:development",
                "compodoc": true,
                "compodocArgs": [
                    "-e",
                    "json",
                    "-d",
                    "apps/web",
                    "-p",
                    "apps/web/tsconfig.app.json"
                ],
                "experimentalZoneless": true
            }
        },
        "test-storybook": {
            "executor": "nx:run-commands",
            "options": {
                "command": "test-storybook -c apps/web/.storybook --url http://localhost:6006"
            }
        }
    }
}
